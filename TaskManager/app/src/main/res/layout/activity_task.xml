<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TaskActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/txtId_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_id_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtId_Task"
        app:layout_constraintBottom_toBottomOf="@id/txtId_Task" />

    <EditText
        android:id="@+id/txtId_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:inputType="text"
        app:layout_constraintStart_toEndOf="@id/textView2"
        app:layout_constraintEnd_toStartOf="@id/btnSearch_Task" />

    <ImageButton
        android:id="@+id/btnSearch_Task"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/task_search_button"
        app:layout_constraintBottom_toBottomOf="@id/txtId_Task"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtId_Task"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_menu_search" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/txtTitle_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_title_label"
        app:layout_constraintBottom_toBottomOf="@id/txtTitle_Task"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTitle_Task"
        app:layout_constraintVertical_bias="0.379" />

    <EditText
        android:id="@+id/txtTitle_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtId_Task"
        android:inputType="text"
        app:layout_constraintStart_toEndOf="@id/textView3"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/txtDescription_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_description_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtDescription_Task"
        app:layout_constraintBottom_toBottomOf="@id/txtDescription_Task" />

    <EditText
        android:id="@+id/txtDescription_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle_Task"
        android:inputType="textMultiLine"
        app:layout_constraintStart_toEndOf="@id/textView4"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/tvDueDate_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_due_date_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvDueDate_Task"
        app:layout_constraintBottom_toBottomOf="@id/tvDueDate_Task" />

    <TextView
        android:id="@+id/tvDueDate_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtDescription_Task"
        android:gravity="center_vertical"
        app:layout_constraintStart_toEndOf="@id/textView5"
        app:layout_constraintEnd_toStartOf="@id/btnDueDate_Task" />

    <ImageButton
        android:id="@+id/btnDueDate_Task"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/task_select_due_date"
        app:srcCompat="@android:drawable/ic_menu_my_calendar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvDueDate_Task"
        app:layout_constraintBottom_toBottomOf="@id/tvDueDate_Task" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/spnStatus_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_status_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/spnStatus_Task"
        app:layout_constraintBottom_toBottomOf="@id/spnStatus_Task" />

    <Spinner
        android:id="@+id/spnStatus_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:spinnerMode="dropdown"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvDueDate_Task"
        app:layout_constraintStart_toEndOf="@id/textView7"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/spnPriority_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_priority_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/spnPriority_Task"
        app:layout_constraintBottom_toBottomOf="@id/spnPriority_Task" />

    <Spinner
        android:id="@+id/spnPriority_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:spinnerMode="dropdown"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spnStatus_Task"
        app:layout_constraintStart_toEndOf="@id/textView8"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/txtAssignTo_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_assigned_to_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtAssignTo_Task"
        app:layout_constraintBottom_toBottomOf="@id/txtAssignTo_Task" />

    <EditText
        android:id="@+id/txtAssignTo_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spnPriority_Task"
        android:inputType="text"
        app:layout_constraintStart_toEndOf="@id/textView9"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:labelFor="@id/txtObservation_Task"
        android:paddingEnd="8dp"
        android:text="@string/task_notes_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtObservation_Task"
        app:layout_constraintBottom_toBottomOf="@id/txtObservation_Task" />

    <EditText
        android:id="@+id/txtObservation_Task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtAssignTo_Task"
        android:inputType="textMultiLine"
        app:layout_constraintStart_toEndOf="@id/textView10"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSave_Task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="48dp"
        android:text="@string/task_save_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtObservation_Task" />

    <Button
        android:id="@+id/btnCancel_Task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/task_clear_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRemove_Task"
        app:layout_constraintVertical_bias="0.2" />

    <Button
        android:id="@+id/btnRemove_Task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="@string/task_delete_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSave_Task" />

</androidx.constraintlayout.widget.ConstraintLayout>