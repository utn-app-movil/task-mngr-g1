<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btnTextTask_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_id" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtId_Task"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/task_label_id"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnSearch_Task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/task_button_search"
                android:src="@android:drawable/ic_menu_search" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_title" />

        <EditText
            android:id="@+id/txtTitle_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/task_label_title"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_description" />

        <EditText
            android:id="@+id/txtDescription_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/task_label_description"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_due_date" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDueDate_Task"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="12dp"
                android:text="@string/task_label_due_date"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnDueDate_Task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/task_label_due_date"
                android:src="@android:drawable/ic_menu_my_calendar" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_status" />

        <Spinner
            android:id="@+id/txtStatus_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/task_status_options" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_priority" />

        <Spinner
            android:id="@+id/txtPriority_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/task_priority_options" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_assigned_to" />

        <EditText
            android:id="@+id/txtAssignTo_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/task_label_assigned_to"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_label_notes" />

        <EditText
            android:id="@+id/txtObservation_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/task_label_notes"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btnSave_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/task_button_save" />

        <Button
            android:id="@+id/btnRemove_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_button_delete" />

        <Button
            android:id="@+id/btnClear_Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_button_clear" />

    </LinearLayout>
</ScrollView>